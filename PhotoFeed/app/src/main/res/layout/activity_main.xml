<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/feedPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black" />

    <TextView
        android:id="@+id/partialAccessBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:background="#CC1A1A1A"
        android:padding="10dp"
        android:text="@string/partial_access_hint"
        android:textColor="@color/grey_300"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 顶部栏：左设置 / 中 Tab / 右删除，半透明叠在内容上；横屏全屏时整体隐藏 -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@android:color/transparent">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            app:tint="#CCFFFFFF" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="2dp"
            app:tabGravity="center"
            app:tabMinWidth="64dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="14dp"
            app:tabPaddingStart="14dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/white"
            app:tabTextAppearance="@style/PhotoFeed.TabText"
            app:tabTextColor="#99FFFFFF" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="#CCFFFFFF" />
    </FrameLayout>

</FrameLayout>
